# ===== 日历数据源：mock | feishu =====
CALENDAR_PROVIDER=feishu
NEXT_PUBLIC_CALENDAR_PROVIDER=feishu

# ===== 飞书自建应用（接真实日历时填写）=====
# 开发者后台 → 凭证与基础信息
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 必须与「安全设置 → 重定向 URL」完全一致，端口与实际运行端口一致
FEISHU_REDIRECT_URI=http://localhost:3001/api/auth/callback
# 国际版 Lark 用 open.larkoffice.com / open.larksuite.com 域名，国内飞书用 open.feishu.cn
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_ACCOUNTS_URL=https://accounts.feishu.cn
# 用户态 OAuth 权限（用户身份），空格分隔，需与「权限管理」中已开通的权限一致：
#   calendar:calendar:read            获取日历信息（读主日历）
#   calendar:calendar.event:read      读取日程（冲突检测 / LLM 避让）
#   calendar:calendar.event:create    创建日程
#   calendar:calendar.free_busy:read  读取忙闲（时段推荐）
#   offline_access                    获取 refresh_token（自动续期必需）
FEISHU_SCOPES=calendar:calendar:read calendar:calendar.event:read calendar:calendar.event:create calendar:calendar.free_busy:read offline_access

# ===== NLU/规划所用模型：留空则使用内置规则解析（Mock）=====
# 任意 OpenAI 兼容网关均可
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ===== 后端持久化与加密 =====
# SQLite 文件位置（默认 ./data/unical.db）；测试可用 :memory:
# DATABASE_URL=./data/unical.db
# 飞书 token 落库前用 AES-256-GCM 加密；生产必填 32 字节十六进制密钥
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# 登录态 cookie 有效期 30 天（服务端固定），无需配置

